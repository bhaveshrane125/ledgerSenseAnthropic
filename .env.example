# Claude is reached through the company's Azure AI Foundry deployment
# (anthropic.AnthropicFoundry), not the direct Anthropic API.
ANTHROPIC_FOUNDRY_API_KEY=
# e.g. https://foundry-resource-eus-001x.services.ai.azure.com/anthropic/
ANTHROPIC_FOUNDRY_BASE_URL=
# The Foundry deployment name (passed as `model` to messages.create).
ANTHROPIC_DEPLOYMENT_NAME=claude-sonnet-5
